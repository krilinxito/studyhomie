{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "changelog-sections": [
    { "type": "feat", "section": "Novedades" },
    { "type": "fix", "section": "Arreglos" },
    { "type": "perf", "section": "Más rápido" },
    { "type": "revert", "section": "Cambios revertidos" },
    { "type": "docs", "section": "Documentación", "hidden": true },
    { "type": "refactor", "section": "Por dentro", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Mantenimiento", "hidden": true }
  ],
  "packages": {
    ".": {}
  }
}
